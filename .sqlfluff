[sqlfluff]
dialect = duckdb
templater = raw
max_line_length = 130
# Layout is left to the author (aligned AS columns are intentional). The rules enforce upper-case
# keywords, literals and types, explicit AS for aliases, unique aliases, qualified column references
# in multi-table queries, <> for not-equal, a final semicolon and a line limit.
# Function case is a documented convention, not a lint rule: window functions in upper case
# (ROW_NUMBER, RANK, LAG), all others in lower case (see docs/sql_style.md).
rules = capitalisation.keywords, capitalisation.literals, capitalisation.types, aliasing.table, aliasing.column, aliasing.unique.table, ambiguous.distinct, ambiguous.union, convention.not_equal, convention.is_null, convention.terminator, layout.end_of_file, layout.long_lines, references.qualification

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper


[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:convention.not_equal]
preferred_not_equal_style = ansi

[sqlfluff:rules:convention.terminator]
multiline_newline = False
require_final_semicolon = True

